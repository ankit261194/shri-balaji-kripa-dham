    <!-- Home Screen -->
    <string name="home_welcome">श्री बालाजी कृपा धाम में आपका स्वागत है</string>
    <string name="home_guruji_section">परम पूज्य गुरुजी परिचय</string>
    <string name="home_guruji_desc">गुरुजी तेजवीर सिंह जी के आशीर्वाद और पावन सानिध्य में हजारों भक्तजन मानसिक कष्टों, भूत-प्रेत बाधाओं एवं सांसारिक व्याधियों से मुक्ति प्राप्त करते हैं। यहाँ केवल ईश्वर भक्ति, निष्काम सेवा और पवित्र नियमों का विधान है।</string>
    <string name="home_sevadar_section">आश्रम के समर्पित सेवादार</string>
    <string name="home_annual_events">वार्षिक धार्मिक उत्सव (मुख्य कार्यक्रम)</string>
    <string name="event_guru_purnima">गुरु पूर्णिमा महोत्सव</string>
    <string name="event_guru_purnima_desc">भव्य गुरु पूजा, अखंड संकीर्तन और विशाल भंडारा/भोज। श्रद्धालु अपनी स्वेच्छा व श्रद्धा से सहयोग कर सकते हैं, कोई दबाव नहीं होता।</string>
    <string name="event_hanuman_jayanti">हनुमान जयंती महोत्सव</string>
    <string name="event_hanuman_jayanti_desc">श्री हनुमान चालीसा, सुंदरकांड पाठ, विशेष दरबार एवं महाप्रसाद वितरण।</string>

